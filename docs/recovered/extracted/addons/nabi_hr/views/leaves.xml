    </template>

    <template id="portal_new_leave_form" name="Mes Congés :: formulaire" >
            <t t-call="portal.portal_layout">
                <t t-set="additional_title">Contact Details</t>
                <form method="post" class="o_portal_leave_form p-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <t t-if="error">
                        <div class="alert alert-danger" role="alert">
                            <t t-esc="error"/>
                        </div>
                    </t>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Type de congé</label>
                        <select name="holiday_status_id" class="form-select form-control-lg">
                            <t t-foreach="request.env['hr.leave.type'].search([])" t-as="lt">
                                <option t-att-value="lt.id">
                                    <t t-esc="lt.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Du</label>
                        <input type="date" name="date_from" class="form-control form-control-lg"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Au</label>
                        <input type="date" name="date_to" class="form-control form-control-lg"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Motif</label>
                        <textarea name="reason" rows="3" class="form-control form-control-lg"/>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 py-3 mt-3" style="border-radius: 12px;">
      📅 Envoyer la demande
                    </button>
                </form>

            </t>
       
    </template>

</odoo>
