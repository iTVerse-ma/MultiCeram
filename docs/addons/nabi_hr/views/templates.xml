    <template id="nabi_hr.portal_magasin" name="Magasin">
      <t t-set="no_header" t-value="True"/>
      <t t-set="no_menu" t-value="True"/>
      <t t-set="no_footer" t-value="True"/>
      <t t-set="full_width" t-value="True"/>
      <t t-set="title" t-value="'Magasin MPR :: Derniers Pointage'"/>
      <t t-call="website.layout">
        <div class="container ">
          <div class="m-5 p-5">

            <h1 style="color:darkblue">Magasin MPR</h1>
            <h3 style="color:tomato">🕓 Dernières pointages</h3>
          </div>
          <div class="row">
            <a t-if="prev" t-att-href="f'/my/magasin'" id="up" class="btn btn-outline-secondary btn-sm me-1 ">
              <i class="fa fa-chevron-up"/>
  Derniers
                            
            </a>
            <t t-esc="page"/>

            <a t-if="prev" t-att-href="f'/my/magasin/{page-1}'" id="prev" class="btn btn-outline-secondary btn-sm me-1 ">
              <i class="fa fa-chevron-left"/>
  précédent
                            
            </a>
            <a t-if="next" t-att-href="f'/my/magasin/{page+1}'" id="next" class="btn btn-outline-secondary btn-sm">
                                 suivant 
              <i class="fa fa-chevron-right"/>
            </a>
          </div>


          <table class="mt-5 table table-bordered ">
            <thead class="table-dark">
              <tr>
                <th>Code Employé</th>
                <th>QR Code</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="punches" t-as="p">
                <tr>
                  <td class="p-5" style="border:solid 1px;border-radius:5px">
                    <img style="float:right" t-att-src="'data:image/png;base64,%s' % p['qr_code']" width="120"/>
                    <h2 style="color:darkblue" t-esc="p['emp_name']"/>
                    <t t-set="punch" t-value="datetime.datetime.strptime(p['punch_time'],'%Y-%m-%d %H:%M:%S')"/>

                    <h3 t-esc="datetime.datetime.strftime(punch,'%Y-%m-%d')"/>
                    <h2 style="color:RED" t-esc="punch.strftime('%H:%M:%S')"/>

                  </td>
                  <td class="p-5" style="border:solid 1px;border-radius:5px">
                    <img class="m-2 p-2" t-att-src="f'/report/barcode/Code128/{p['emp_code']}?width=400&amp;height=200&amp;humanreadable=1&amp;margin=0&amp;quiet=1'"/>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
          <script> setTimeout(() =&gt; window.location.reload(), 30000); // refresh every 30s </script>
        </div>
      </t>

    </template>




    <template id="nabi_hr.portal_my_home" name="nabi: Home" customize_show="True" inherit_id="portal.portal_my_home" priority="60">

      <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
        <t t-set="portal_ot_category_enable" t-value="True"/>
        <t t-set="portal_leave_category_enable" t-value="True"/>
        <t t-set="portal_rh_category_enable" t-value="True"/>

      </xpath>
      <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">

        <div t-if="portal_ot_category_enable" class="o_portal_category row g-2 mt-3" id="portal_ot_category"/>

        <div t-if="portal_leave_category_enable" class="o_portal_category row g-2 mt-3" id="portal_leave_category"/>
        <div t-if="portal_rh_category_enable" class="o_portal_category row g-2 mt-3" id="portal_rh_category"/>



      </xpath>

    </template>



    <template id="nabi_hr.overtime" name="Overtimes" customize_show="True" inherit_id="portal.portal_my_home" priority="61">
      <div id="portal_ot_category" position="inside">
        <t t-call="portal.portal_docs_entry">
          <t t-set="icon" t-value="'/nabi_hr/static/src/img/timesheet.svg'"/>
          <t t-set="title">Heures Supplèmentaires</t>
          <t t-set="url" t-value="'/my/ot?filterby=invoices'"/>
          <t t-set="text">Suivres tes HS</t>
          <t t-set="config_card" t-value="True"/>
        </t>
        <t t-call="portal.portal_docs_entry">
          <t t-set="icon" t-value="'/nabi_hr/static/src/img/Annual_Time_Off.svg'"/>
          <t t-set="title">Jour de repos</t>
          <t t-set="url" t-value="'/my/reste-days'"/>
          <t t-set="text">Planning des jours de repos</t>
          <t t-set="config_card" t-value="True"/>
        </t>
      </div>
      <div id="portal_leave_category" position="inside">
        <t t-call="portal.portal_docs_entry">
          <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
          <t t-set="title">Congés</t>
          <t t-set="url" t-value="'/my/leaves'"/>
          <t t-set="text">Suivres mes congés</t>
          <t t-set="config_card" t-value="True"/>
        </t>
        <t t-call="portal.portal_docs_entry">
          <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
          <t t-set="title">Autorisations</t>
          <t t-set="url" t-value="'/my/authorisation'"/>
          <t t-set="text">Suivres mes authorisations</t>
          <t t-set="config_card" t-value="True"/>
        </t>
      </div>
      <div id="portal_rh_category" position="inside">
        <t t-call="portal.portal_docs_entry">
          <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
          <t t-set="title">Pointages</t>
          <t t-set="url" t-value="f'/my/attendance/{datetime.datetime.now()}'"/>
          <t t-set="text">Gestion des pointages et anomalies</t>
          <t t-set="config_card" t-value="True"/>
        </t>
        <t t-call="portal.portal_docs_entry">
          <t t-set="icon" t-value="'/nabi_hr/static/src/img/empty.svg'"/>
          <t t-set="title">Restaurant</t>
          <t t-set="url" t-value="'/my/restaurant'"/>
          <t t-set="text">Gestion des service restauration</t>
          <t t-set="config_card" t-value="True"/>
        </t>
      </div>
    </template>

  </data>

</odoo>
