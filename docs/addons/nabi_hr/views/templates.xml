<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <template id="nabi_hr.portal_punch_stacked_template" name="get punches view Stacked" customize_show="True">
      <!-- Hide portal header/footer/menu -->
      <t t-set="no_header" t-value="True"/>
      <t t-set="no_menu" t-value="True"/>
      <t t-set="no_footer" t-value="True"/>
      <!-- Use lightweight layout -->
      <t t-call="website.layout">
        <div class="container my-4 d-flex" id="stacked-punches-page">
          <!-- Filters -->
          <div class="col-3 h-100 ">
            <h4>Pointages </h4>
            <div class=" mb-3 d-flex flex-column ">
              <div class="mb-2">
                <label>Employé</label>
                <select id="filter_employee" class="form-select form-select-sm">
                  <t t-foreach="request.env['hr.employee'].search([])" t-as="emp">
                    <option t-att-value="emp_id" t-esc="f'{emp.barcode}- {emp.name}'" />
                  </t>
                </select>
              </div>
              <div class="mb-2 ">
                <label>Terminals</label>
                <select style="height:200px" id="filter_terminal" class="form-select form-select-sm" multiple="1">
                  <t t-foreach="terminals" t-as="term">
                    <option t-att-value="term.id" t-esc="term.alias" t-att-selected="terminals_ids.indexOf(term.id)&gt;=0"/>
                  </t>
                </select>
              </div>
              <div class="mb-2">
                <label>Date From</label>
                <input type="date" id="filter_from" class="form-control form-control-sm" t-att-value="start_day"/>
              </div>
              <div class="mb-2">
                <label>Date To</label>
                <input type="date" id="filter_to" class="form-control form-control-sm" t-att-value="end_day"/>
              </div>
              <div class=" mb-2 ">
                <button id="filter_btn" class="btn btn-primary btn-sm w-100">Filter / Refresh</button>
              </div>
            </div>
          </div>
          <!-- Punches Table -->
          <div class=" ml32 col-9" style="height: 100vh; overflow-y: auto;">
            <div class=" mt-1">
              <button class="col-1 btn btn-sm btn-info" data-action="show_report" data-empid="263" data-curdate="2025-11-05">
                <i class="fa fa-file-text"/>Rapport </button>
              <button class="col-1 btn btn-sm btn-success" data-action="add_punch" t-att-data-id="" t-att-data-empid="emp_id" t-att-data-curdate="start_day">
                <i class="fa fa-plus"/>Ajouter</button>
              <button class="col-1 btn btn-sm btn-warning" data-action="add_leave" data-empid="773" data-curdate="2025-11-05">
                <i class="fa fa-solid fa-suitcase"/>Congé</button>
            </div>
            <table class="table table-striped table-sm table-hover sortable">
              <thead class="table-light position-sticky sticky-top">
                <tr>
                  <th>Employée</th>
                  <th>Terminal</th>
                  <th>Date</th>
                  <th colspan="2">Temps</th>
                </tr>
              </thead>
              <tbody id="punches_table_body">
                <t t-foreach="portal_punches" t-as="p">
                  <tr t-att-data-id="p.id">
                    <td>
                      <span t-esc="p.employee_id.name"/>
                    </td>
                    <td t-att-class="{'t':'bg-primary','p':'bg-success', 'r':'bg-warning'}.get(p.terminal_id.usage) ">
                      <span t-esc="{'in':'⬅','out':'➡ '}.get(p.terminal_id.sens)" t-att-style="{'in':'color:green','out':'color:red'}.get(p.terminal_id.sens)"/>
                      <span t-esc="p.terminal_id.alias"/>
                    </td>
                    <td>
                      <span t-esc="p.punch_time.date()"/>
                    </td>
                    <td>
                      <span t-esc="p.punch_time.strftime('%H:%M')"/>
                    </td>
                    <td style="text-align:right" class="d-flex flex-row">
                      <button class=" btn btn-sm btn-warning" data-action="add_leave" data-empid="773" data-curdate="2025-11-05">
                        <i class="fa fa-trash"/>Supprimer</button>
                      <button class=" btn btn-sm btn-warning" data-action="add_leave" data-empid="773" data-curdate="2025-11-05">
                        <i class="fa fa-copy"/>Dupliqué</button>
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
        </div>
      </t>
    </template>
