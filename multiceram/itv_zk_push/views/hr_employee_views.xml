<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_itv_push" model="ir.ui.view">
        <field name="name">hr.employee.form.itv.push</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_push_to_biotime" type="object" string="Envoyer vers BioTime"
                        class="btn-secondary" invisible="not barcode"/>
                <field name="itv_push_state" widget="statusbar" statusbar_visible="draft,sent"/>
            </xpath>
            <!-- Ce qu'on tape sur la pointeuse : matricule (identifiant) et Code PIN, puis où il pointe. -->
            <xpath expr="//group[@name='identification_group']/field[@name='pin']" position="attributes">
                <attribute name="help">Code tapé sur la pointeuse après le matricule (et dans le mode kiosque d'Odoo). Chiffres uniquement.</attribute>
            </xpath>
            <xpath expr="//group[@name='identification_group']/label[@for='barcode']" position="attributes">
                <attribute name="string">Matricule (ID pointeuse)</attribute>
            </xpath>
            <xpath expr="//group[@name='identification_group']" position="inside">
                <field name="itv_card_no" placeholder="Passer la carte sur la pointeuse"/>
                <field name="itv_terminal_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
            <!-- Suivi de la synchronisation, à côté de l'identifiant BioTime. -->
            <xpath expr="//group[@name='itv_biotime']" position="inside">
                <field name="itv_push_state"/>
                <field name="itv_pushed_at" readonly="1" invisible="not itv_pushed_at"/>
                <field name="itv_push_error" readonly="1" invisible="itv_push_state != 'error'"/>
            </xpath>
        </field>
    </record>
</odoo>
