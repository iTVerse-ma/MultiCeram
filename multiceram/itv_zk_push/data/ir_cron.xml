<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rejoue les envois d'employés restés en attente (BioTime injoignable, erreur passagère). -->
        <record id="ir_cron_itv_zk_push_employees" model="ir.cron">
            <field name="name">BioTime : envoi des employés en attente</field>
            <field name="model_id" ref="itv_zk_connector.model_itv_zk_outbox"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_employees()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
