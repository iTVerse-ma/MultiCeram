<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Un seul niveau d'accès « Présences » : Employé, Responsable N1, Responsable N2, Administrateur. -->
    <record id="hr_attendance.group_hr_attendance_own_reader" model="res.groups">
        <field name="name">Employé</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="comment">Voit ses propres présences.</field>
    </record>

    <!-- Niveaux natifs intermédiaires : gardés pour les droits, retirés de la liste de choix. -->
    <record id="hr_attendance.group_hr_attendance_officer" model="res.groups">
        <field name="privilege_id" eval="False"/>
    </record>

    <record id="hr_attendance.group_hr_attendance_user" model="res.groups">
        <field name="privilege_id" eval="False"/>
    </record>

    <record id="group_itv_overtime_validation_1" model="res.groups">
        <field name="name">Responsable N1</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="implied_ids" eval="[(6, 0, [ref('hr_attendance.group_hr_attendance_officer')])]"/>
        <field name="comment">Gère les présences de ses employés et valide les heures supplémentaires au premier niveau.</field>
    </record>

    <record id="group_itv_overtime_validation_2" model="res.groups">
        <field name="name">Responsable N2</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_itv_overtime_validation_1'), ref('hr_attendance.group_hr_attendance_user')])]"/>
        <field name="comment">Voit toutes les présences et valide au second niveau les heures déjà validées par un responsable N1.</field>
    </record>

    <record id="hr_attendance.group_hr_attendance_manager" model="res.groups">
        <field name="name">Administrateur</field>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_itv_overtime_validation_2')), (4, ref('base.group_system'))]"/>
        <field name="comment">Tout : configuration, périodes, recalculs, validations, et attribution des accès (Paramètres).</field>
    </record>

    <record id="itv_attendance_day_company_rule" model="ir.rule">
        <field name="name">Journée de pointage : multi-société</field>
        <field name="model_id" ref="model_itv_attendance_day"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="itv_attendance_day_rule_all" model="ir.rule">
        <field name="name">Journée de pointage : tous les employés</field>
        <field name="model_id" ref="model_itv_attendance_day"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
    </record>

    <record id="itv_attendance_day_rule_officer" model="ir.rule">
        <field name="name">Journée de pointage : employés gérés</field>
        <field name="model_id" ref="model_itv_attendance_day"/>
        <field name="domain_force">[('employee_id.attendance_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
    </record>

    <record id="itv_attendance_day_rule_validation" model="ir.rule">
        <field name="name">Journée de pointage : valideurs des heures supplémentaires</field>
        <field name="model_id" ref="model_itv_attendance_day"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_itv_overtime_validation_1'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itv_overtime_line_rule_validation" model="ir.rule">
        <field name="name">Heures supplémentaires : valideurs du circuit</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance_overtime_line"/>
        <field name="domain_force">[('itv_state', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_itv_overtime_validation_1'))]"/>
    </record>
</odoo>
