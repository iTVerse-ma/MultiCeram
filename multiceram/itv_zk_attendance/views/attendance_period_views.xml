<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itv_attendance_period_view_list" model="ir.ui.view">
        <field name="name">itv.attendance.period.list</field>
        <field name="model">itv.attendance.period</field>
        <field name="arch" type="xml">
            <list string="Périodes de pointage" editable="bottom"
                  decoration-muted="state == 'closed'" decoration-warning="skipped_count &gt; 0">
                <field name="month" widget="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" readonly="1"
                       decoration-success="state == 'open'" decoration-muted="state == 'closed'"/>
                <field name="skipped_count" readonly="1"/>
                <field name="closed_uid" readonly="1" optional="show"/>
                <field name="closed_date" readonly="1" optional="hide"/>
                <field name="note"/>
                <button name="action_close" type="object" string="Clôturer" class="btn-link" icon="fa-lock"
                        invisible="state == 'closed'"/>
                <button name="action_open" type="object" string="Rouvrir" class="btn-link" icon="fa-unlock"
                        invisible="state == 'open'"/>
                <button name="action_recompute" type="object" string="Recalculer le mois" class="btn-link" icon="fa-refresh"
                        invisible="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="itv_attendance_period_action" model="ir.actions.act_window">
        <field name="name">Périodes de pointage</field>
        <field name="res_model">itv.attendance.period</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="itv_attendance_period_view_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune période</p>
            <p>Clôturez un mois une fois la paie faite : ses journées ne sont plus recalculées. Les pointages qui arrivent après la clôture sont comptés dans « Modifications ignorées » au lieu de changer les chiffres.</p>
        </field>
    </record>

    <menuitem id="menu_itv_attendance_period" name="Périodes de pointage" parent="hr_attendance.menu_hr_attendance_configuration"
              action="itv_attendance_period_action" sequence="16"/>
</odoo>
