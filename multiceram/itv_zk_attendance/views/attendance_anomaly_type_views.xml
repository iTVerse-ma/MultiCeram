<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itv_attendance_anomaly_type_view_list" model="ir.ui.view">
        <field name="name">itv.attendance.anomaly.type.list</field>
        <field name="model">itv.attendance.anomaly.type</field>
        <field name="arch" type="xml">
            <list string="Types d'anomalie" editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" readonly="1"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="itv_attendance_anomaly_type_action" model="ir.actions.act_window">
        <field name="name">Types d'anomalie</field>
        <field name="res_model">itv.attendance.anomaly.type</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="itv_attendance_anomaly_type_view_list"/>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun type d'anomalie</p>
            <p>Renommez les types, changez leur ordre, ou désactivez-en un pour que les journées concernées ne soient plus signalées.</p>
        </field>
    </record>

    <menuitem id="menu_itv_attendance_anomaly_type" name="Types d'anomalie" parent="hr_attendance.menu_hr_attendance_configuration"
              action="itv_attendance_anomaly_type_action" sequence="15"/>
</odoo>
