<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Droits : groupes de Présences (Gestionnaire, Responsable, Administrateur). -->
    <record id="itv_zk_backend_company_rule" model="ir.rule">
        <field name="name">Connexion BioTime : multi-société</field>
        <field name="model_id" ref="model_itv_zk_backend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="itv_zk_terminal_company_rule" model="ir.rule">
        <field name="name">Terminal BioTime : multi-société</field>
        <field name="model_id" ref="model_itv_zk_terminal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="itv_zk_punch_company_rule" model="ir.rule">
        <field name="name">Pointage brut : multi-société</field>
        <field name="model_id" ref="model_itv_zk_punch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="itv_zk_punch_rule_all" model="ir.rule">
        <field name="name">Pointage brut : tous les employés</field>
        <field name="model_id" ref="model_itv_zk_punch"/>
        <!-- Périmètre « moi et tout ce qui dépend de moi » dans l'organigramme. -->
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
    </record>

    <record id="itv_zk_punch_rule_officer" model="ir.rule">
        <field name="name">Pointage brut : employés gérés</field>
        <field name="model_id" ref="model_itv_zk_punch"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
    </record>
</odoo>
