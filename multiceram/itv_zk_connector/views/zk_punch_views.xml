<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itv_zk_punch_view_list" model="ir.ui.view">
        <field name="name">itv.zk.punch.list</field>
        <field name="model">itv.zk.punch</field>
        <field name="arch" type="xml">
            <list string="Pointages bruts" create="0" delete="0" editable="bottom"
                  decoration-muted="duplicate or to_delete" decoration-warning="upload_delay_min &gt; 1440">
                <field name="punch_local" readonly="1"/>
                <field name="punch_date" optional="hide" readonly="1"/>
                <field name="employee_id" readonly="1"/>
                <field name="emp_code" readonly="1"/>
                <field name="terminal_id" readonly="1"/>
                <field name="usage" readonly="1"/>
                <field name="direction" optional="show" readonly="1"/>
                <field name="punch_state" optional="hide" readonly="1"/>
                <field name="source" optional="hide" readonly="1"/>
                <field name="upload_delay_min" optional="hide" readonly="1"/>
                <field name="duplicate"/>
                <field name="to_delete"/>
                <field name="date_override" optional="hide"/>
                <field name="backend_id" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="itv_zk_punch_view_pivot" model="ir.ui.view">
        <field name="name">itv.zk.punch.pivot</field>
        <field name="model">itv.zk.punch</field>
        <field name="arch" type="xml">
            <pivot string="Pointages bruts">
                <field name="terminal_id" type="row"/>
                <field name="punch_date" interval="day" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="itv_zk_punch_view_search" model="ir.ui.view">
        <field name="name">itv.zk.punch.search</field>
        <field name="model">itv.zk.punch</field>
        <field name="arch" type="xml">
            <search string="Pointages bruts">
                <field name="employee_id"/>
                <field name="emp_code"/>
                <field name="terminal_id"/>
                <field name="backend_id"/>
                <filter string="Aujourd'hui" name="today" domain="[('punch_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Hier" name="yesterday" domain="[('punch_date', '=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="7 derniers jours" name="last_7_days" domain="[('punch_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Présence" name="usage_t" domain="[('usage', '=', 't')]"/>
                <filter string="Porte" name="usage_p" domain="[('usage', '=', 'p')]"/>
                <filter string="Restaurant" name="usage_r" domain="[('usage', '=', 'r')]"/>
                <filter string="Magasin" name="usage_m" domain="[('usage', '=', 'm')]"/>
                <filter string="Terminal à classer" name="usage_unclassified" domain="['|', ('terminal_id', '=', False), ('usage', '=', 'unclassified')]"/>
                <separator/>
                <filter string="Doublons" name="duplicate" domain="[('duplicate', '=', True)]"/>
                <filter string="Écartés" name="to_delete" domain="[('to_delete', '=', True)]"/>
                <filter string="Employé inconnu" name="no_employee" domain="[('employee_id', '=', False)]"/>
                <separator/>
                <filter string="Reçu avec plus de 2 h de retard" name="late_2h" domain="[('upload_delay_min', '&gt;', 120)]"/>
                <filter string="Reçu avec plus d'un jour de retard" name="late_1d" domain="[('upload_delay_min', '&gt;', 1440)]"/>
                <group>
                    <filter string="Employé" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Terminal" name="group_terminal" context="{'group_by': 'terminal_id'}"/>
                    <filter string="Usage" name="group_usage" context="{'group_by': 'usage'}"/>
                    <filter string="Jour" name="group_day" context="{'group_by': 'punch_date:day'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="itv_zk_punch_action" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">itv.zk.punch</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_yesterday': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun pointage</p>
            <p>Les pointages arrivent de BioTime par la synchronisation planifiée.</p>
        </field>
    </record>
</odoo>
