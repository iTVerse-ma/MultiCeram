<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_itv_zk" model="ir.ui.view">
        <field name="name">hr.employee.form.itv.zk</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="BioTime" name="itv_biotime">
                    <field name="itv_biotime_emp_id" readonly="1"/>
                    <field name="itv_to_complete"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_search_itv_zk" model="ir.ui.view">
        <field name="name">hr.employee.search.itv.zk</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Fiche BioTime à compléter" name="itv_to_complete"
                        domain="[('itv_to_complete', '=', True)]" groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>
</odoo>
