<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itv_zk_outbox_view_list" model="ir.ui.view">
        <field name="name">itv.zk.outbox.list</field>
        <field name="model">itv.zk.outbox</field>
        <field name="arch" type="xml">
            <list string="File d'envoi BioTime" create="0">
                <field name="create_date" string="Créé le"/>
                <field name="operation"/>
                <field name="res_model" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"
                       decoration-info="state == 'sent'" decoration-danger="state == 'error'"/>
                <field name="attempts"/>
                <field name="biotime_ref" optional="show"/>
                <field name="sent_at" optional="show"/>
                <field name="backend_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="itv_zk_outbox_view_form" model="ir.ui.view">
        <field name="name">itv.zk.outbox.form</field>
        <field name="model">itv.zk.outbox</field>
        <field name="arch" type="xml">
            <form string="Envoi BioTime" create="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id"/>
                            <field name="operation"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="biotime_ref"/>
                            <field name="sent_at"/>
                        </group>
                    </group>
                    <group string="Contenu">
                        <field name="payload" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Dernière erreur" invisible="not last_error">
                        <field name="last_error" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="itv_zk_outbox_action" model="ir.actions.act_window">
        <field name="name">File d'envoi BioTime</field>
        <field name="res_model">itv.zk.outbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Rien à envoyer</p>
            <p>Les écritures vers BioTime (pointages manuels, plannings, passages UHF) transitent par cette file.</p>
        </field>
    </record>
</odoo>
