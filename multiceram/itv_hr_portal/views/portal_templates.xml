<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tuiles de l'accueil du portail -->
    <template id="portal_my_home_itv" inherit_id="portal.portal_my_home" name="Portail RH : tuiles">
        <xpath expr="//div[@id='portal_common_category']" position="before">
            <div t-if="itv_employee" class="o_portal_category row g-2 mt-3" id="portal_rh_category">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                    <t t-set="title">Mes pointages</t>
                    <t t-set="text">Mes journées, heures et anomalies</t>
                    <t t-set="url" t-value="'/my/pointages'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                    <t t-set="title">Mes congés</t>
                    <t t-set="text">Demander un congé et suivre mes demandes</t>
                    <t t-set="url" t-value="'/my/conges'"/>
                    <t t-set="count" t-value="itv_leave_count"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                    <t t-set="title">Mes anomalies</t>
                    <t t-set="text">Expliquer une journée signalée</t>
                    <t t-set="url" t-value="'/my/anomalies'"/>
                    <t t-set="count" t-value="itv_anomaly_count"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                    <t t-set="title">Mes heures supplémentaires</t>
                    <t t-set="text">Heures déclarées et validées</t>
                    <t t-set="url" t-value="'/my/heures-supplementaires'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </xpath>
    </template>

    <!-- Mes pointages : une ligne par journée du mois -->
    <template id="portal_my_days" name="Mes pointages">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mes pointages</t>
            </t>

            <div class="d-flex align-items-center justify-content-between my-3">
                <a class="btn btn-sm btn-light"
                   t-attf-href="/my/pointages/#{previous_month.year}/#{previous_month.month}">← Mois précédent</a>
                <strong t-out="month_start" t-options="{'widget': 'date', 'format': 'MMMM yyyy'}"/>
                <a t-if="next_allowed" class="btn btn-sm btn-light"
                   t-attf-href="/my/pointages/#{next_month.year}/#{next_month.month}">Mois suivant →</a>
                <span t-else="" class="btn btn-sm btn-light disabled">Mois suivant →</span>
            </div>

            <p t-if="not days" class="alert alert-info">Aucune journée enregistrée pour ce mois.</p>

            <div t-if="days" class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Pointages</th>
                            <th class="text-end">H. présence</th>
                            <th class="text-end">H. normales</th>
                            <th class="text-end">HS</th>
                            <th>Journée</th>
                            <th>Anomalie</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="days" t-as="day">
                            <td t-out="day.date" t-options="{'widget': 'date'}"/>
                            <td t-out="day.punch_summary or '—'"/>
                            <td class="text-end" t-out="day.lg_heures" t-options="{'widget': 'float_time'}"/>
                            <td class="text-end" t-out="day.lg_heures25" t-options="{'widget': 'float_time'}"/>
                            <td class="text-end" t-out="day.lg_hs" t-options="{'widget': 'float_time'}"/>
                            <td>
                                <span t-if="day.is_holiday" class="badge text-bg-info">Jour férié</span>
                                <span t-if="day.is_rest_day" class="badge text-bg-secondary">Jour de repos</span>
                            </td>
                            <td>
                                <span t-if="day.anomaly_state == 'open'" class="badge text-bg-warning"
                                      t-out="day.anomaly_label or 'À traiter'"/>
                                <span t-elif="day.anomaly_state == 'justified'" class="badge text-bg-success">Justifiée</span>
                                <span t-elif="day.anomaly_state == 'ignored'" class="badge text-bg-light">Ignorée</span>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="2">Total du mois</td>
                            <td class="text-end" t-out="totals['lg_heures']" t-options="{'widget': 'float_time'}"/>
                            <td class="text-end" t-out="totals['lg_heures25']" t-options="{'widget': 'float_time'}"/>
                            <td class="text-end" t-out="totals['lg_hs']" t-options="{'widget': 'float_time'}"/>
                            <td colspan="2">
                                <t t-out="totals['lg_worked_day']"/> jour(s) travaillé(s),
                                <t t-out="totals['lg_absent_day']"/> sans pointage
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </template>

    <!-- Mes congés -->
    <template id="portal_my_leaves" name="Mes congés">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mes congés</t>
            </t>

            <div t-if="message == 'demande_enregistree'" class="alert alert-success">Votre demande a été enregistrée.</div>
            <div t-if="message == 'demande_annulee'" class="alert alert-success">Votre demande a été retirée.</div>
            <div t-if="message == 'annulation_impossible'" class="alert alert-warning">
                Cette demande est déjà traitée : contactez le service du personnel.
            </div>

            <a class="btn btn-primary my-3" href="/my/conges/nouveau">Demander un congé</a>

            <p t-if="not leaves" class="alert alert-info">Vous n'avez aucune demande de congé.</p>

            <div t-if="leaves" class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Type</th><th>Du</th><th>Au</th><th class="text-end">Jours</th><th>État</th><th/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="leaves" t-as="leave">
                            <td t-out="leave.holiday_status_id.display_name"/>
                            <td t-out="leave.request_date_from" t-options="{'widget': 'date'}"/>
                            <td t-out="leave.request_date_to" t-options="{'widget': 'date'}"/>
                            <td class="text-end" t-out="leave.number_of_days"/>
                            <td>
                                <span t-if="leave.state == 'confirm'" class="badge text-bg-warning">À approuver</span>
                                <span t-elif="leave.state in ('validate', 'validate1')" class="badge text-bg-success">Approuvé</span>
                                <span t-elif="leave.state == 'refuse'" class="badge text-bg-danger">Refusé</span>
                                <span t-else="" class="badge text-bg-light" t-out="leave.state"/>
                            </td>
                            <td class="text-end">
                                <form t-if="leave.state in cancelable_states" method="post"
                                      t-attf-action="/my/conges/#{leave.id}/annuler">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Retirer</button>
                                </form>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- Formulaire de demande -->
    <template id="portal_leave_form" name="Demander un congé">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Demander un congé</t>
            </t>

            <div t-if="error" class="alert alert-danger" t-out="error"/>

            <form method="post" action="/my/conges/nouveau" class="col-12 col-lg-6">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="mb-3">
                    <label class="form-label" for="leave_type_id">Type de congé</label>
                    <select class="form-select" name="leave_type_id" id="leave_type_id" required="required">
                        <option value="">—</option>
                        <option t-foreach="leave_types" t-as="leave_type" t-att-value="leave_type.id"
                                t-att-selected="'selected' if post.get('leave_type_id') == str(leave_type.id) else None"
                                t-out="leave_type.display_name"/>
                    </select>
                </div>
                <div class="row">
                    <div class="col mb-3">
                        <label class="form-label" for="date_from">Du</label>
                        <input type="date" class="form-control" name="date_from" id="date_from"
                               t-att-value="post.get('date_from')" required="required"/>
                    </div>
                    <div class="col mb-3">
                        <label class="form-label" for="date_to">Au</label>
                        <input type="date" class="form-control" name="date_to" id="date_to"
                               t-att-value="post.get('date_to')" required="required"/>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="reason">Motif (facultatif)</label>
                    <input type="text" class="form-control" name="reason" id="reason" maxlength="200"
                           t-att-value="post.get('reason')"/>
                </div>
                <button type="submit" class="btn btn-primary">Envoyer la demande</button>
                <a class="btn btn-link" href="/my/conges">Annuler</a>
            </form>
        </t>
    </template>

    <!-- Mes anomalies : l'employé explique, les RH tranchent -->
    <template id="portal_my_anomalies" name="Mes anomalies">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mes anomalies</t>
            </t>

            <div t-if="message == 'explication_envoyee'" class="alert alert-success">
                Votre explication a été transmise au service du personnel.
            </div>
            <div t-if="message == 'explication_vide'" class="alert alert-warning">Écrivez une explication avant d'envoyer.</div>
            <div t-if="message == 'deja_traitee'" class="alert alert-warning">Cette journée a déjà été traitée.</div>

            <p t-if="not days" class="alert alert-info">Aucune anomalie ne vous a été envoyée. Rien à expliquer.</p>

            <div t-if="days" class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr><th>Date</th><th>Pointages</th><th>Anomalie</th><th>Votre explication</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="days" t-as="day">
                            <td t-out="day.date" t-options="{'widget': 'date'}"/>
                            <td t-out="day.punch_summary or '—'"/>
                            <td>
                                <span class="badge text-bg-warning" t-out="day.anomaly_label or 'À traiter'"/>
                                <div t-if="day.itv_portal_message" class="small text-muted" t-out="day.itv_portal_message"/>
                            </td>
                            <td>
                                <t t-if="day.itv_portal_state == 'submitted'">
                                    <span class="badge text-bg-info">En attente des RH</span>
                                    <div class="small text-muted" t-out="day.itv_portal_reason"/>
                                </t>
                                <t t-elif="day.itv_portal_state == 'accepted'">
                                    <span class="badge text-bg-success">Acceptée</span>
                                    <div class="small text-muted" t-out="day.itv_portal_reason"/>
                                </t>
                                <t t-elif="day.itv_portal_state == 'refused'">
                                    <span class="badge text-bg-danger">Refusée</span>
                                    <div class="small text-muted" t-out="day.itv_portal_reason"/>
                                </t>
                                <t t-else="">
                                    <div t-if="day.itv_portal_reason" class="small text-danger mb-1">
                                        Explication à revoir : <t t-out="day.itv_portal_reason"/>
                                    </div>
                                    <form method="post" t-attf-action="/my/anomalies/#{day.id}/justifier"
                                          class="d-flex gap-2">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="text" class="form-control form-control-sm" name="reason"
                                               maxlength="500" placeholder="Ex. oubli de badgeage à la sortie"/>
                                        <button type="submit" class="btn btn-sm btn-primary">Envoyer</button>
                                    </form>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- Mes heures supplémentaires : lecture seule, l'employé suit le circuit de validation -->
    <template id="portal_my_overtime" name="Mes heures supplémentaires">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mes heures supplémentaires</t>
            </t>

            <div class="row g-2 my-3">
                <div class="col-6 col-md-3">
                    <div class="border rounded p-3">
                        <div class="text-muted small">Validées</div>
                        <div class="fs-4" t-out="validated_total" t-options="{'widget': 'float_time'}"/>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-3">
                        <div class="text-muted small">En cours de validation</div>
                        <div class="fs-4" t-out="pending_total" t-options="{'widget': 'float_time'}"/>
                    </div>
                </div>
            </div>

            <p t-if="not lines" class="alert alert-info">
                Aucune heure supplémentaire déclarée. Les heures sont mises en circuit par le service du personnel.
            </p>

            <div t-foreach="months" t-as="month" class="mb-4">
                <h5 t-out="month[0]" t-options="{'widget': 'date', 'format': 'MMMM yyyy'}"/>
                <table class="table table-sm">
                    <thead>
                        <tr><th>Date</th><th>Taux</th><th class="text-end">Heures</th><th>État</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="month[1]" t-as="line">
                            <td t-out="line.date" t-options="{'widget': 'date'}"/>
                            <td><t t-out="line.itv_rate or int((line.amount_rate - 1) * 100)"/> %</td>
                            <td class="text-end" t-out="line.duration" t-options="{'widget': 'float_time'}"/>
                            <td>
                                <span t-if="line.itv_state == 'validated_2'" class="badge text-bg-success">Validée</span>
                                <span t-elif="line.itv_state == 'validated_1'" class="badge text-bg-info">Validée N1</span>
                                <span t-elif="line.itv_state == 'submitted'" class="badge text-bg-warning">En circuit</span>
                                <span t-elif="line.itv_state == 'refused'" class="badge text-bg-danger">Refusée</span>
                                <span t-else="" class="badge text-bg-light">Brouillon</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

</odoo>
