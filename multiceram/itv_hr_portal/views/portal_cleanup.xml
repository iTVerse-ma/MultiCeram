<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Le portail sert au personnel : on retire les tuiles commerciales d'Odoo.
         Les vues d'origine sont seulement désactivées (réactivables sans perte). -->
    <record id="sale.portal_my_home_sale" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
    <record id="account.portal_my_home_invoice" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
    <record id="account_payment.portal_my_home_account_payment" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
    <record id="payment.portal_my_home_payment" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- « Adresses » est écrit directement dans le modèle d'Odoo : on retire l'entrée. -->
    <template id="portal_my_home_no_addresses" inherit_id="portal.portal_my_home"
              name="Portail RH : sans la tuile Adresses">
        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-value=&quot;'/my/addresses'&quot;]]" position="replace"/>
    </template>
</odoo>
