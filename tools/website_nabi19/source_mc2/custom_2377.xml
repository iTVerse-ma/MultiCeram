<t t-name="base.portal_attendance">
    <t t-call="portal.portal_layout">
        <t t-set="breadcrumbs_searchbar" t-value="True"/>
        
        <t t-set="searchbar_sortings" t-value="{'emp': {'label': 'Employeé', 'order': 'emp desc'},   'date': {'label': 'Jour', 'order': 'check_in desc'},        }"/>

        
        <t t-call="portal.portal_searchbar">
            <t t-set="title">Punches</t>
        </t>
        <div class="container py-4">
            <h2 class="text-center mb-4">Pointages et correctionss</h2>
            <div class="table-responsive">
                <t t-call="portal.portal_table">
                    <thead class="table-light">
                        <tr class="active">
                            <th name="employee_id">Employé</th>
                            <th>Jour</th>
                            <th>Pointages</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="employees" t-as="emp">
                            <t t-foreach="days" t-as="day">
                                <tr>
                                    <td class="fw-bold">
                                        <t t-esc="emp.name"/>
                                    </td>
                                    <td>
                                        <t t-esc="day.strftime('%A %d/%m/%Y')"/>
                                    </td>
                                    <td>
                                        <t t-set="day_punches" t-value="punches.get(emp.id, {}).get(day, [])"/>
                                        <t t-if="day_punches">
                                            <t t-foreach="day_punches" t-as="p">
                                                <div class="small border rounded mb-1 p-1">
                                                    <t t-esc="p.check_in.strftime('%H:%M')"/> - 
                                                    <t t-esc="p and p.check_out and p.check_out.strftime('%H:%M')"/>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-if="not day_punches">
                                            <span class="text-muted small">Aucun</span>
                                        </t>
                                    </td>
                                    <td>
                                        <form method="post" action="/my/attendance/action">
                                            <input type="hidden" name="employee_id" t-att-value="emp.id"/>
                                            <input type="hidden" name="day" t-att-value="day"/>
                                            <div class="d-flex flex-wrap justify-content-center gap-1">
                                                <button name="action" value="manual" class="btn btn-sm btn-outline-primary">Manuel</button>
                                                <button name="action" value="delete_repeated" class="btn btn-sm btn-outline-danger">Suppr doublon</button>
                                                <button name="action" value="we" class="btn btn-sm btn-outline-success">WE</button>
                                                <button name="action" value="holiday" class="btn btn-sm btn-outline-warning">Férié</button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </t>
            </div>
        </div>
    </t>
</t>
